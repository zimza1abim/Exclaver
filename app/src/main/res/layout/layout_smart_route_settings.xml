<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smart_route_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/smart_route_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_not_configured"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:id="@+id/smart_route_proxy_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <Button
                android:id="@+id/open_proxy_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_open_proxy_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/smart_route_domain_list"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_domain_list_summary"
                android:textAppearance="?attr/textAppearanceBody2" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smart_route_domain_input_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/domain_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:singleLine="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/domain_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_add_domain" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/smart_route_search_domains">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/domain_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/domain_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/smart_route_checked_domains"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <LinearLayout
                android:id="@+id/domain_checked_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/domain_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_no_domains"
                android:textAppearance="?attr/textAppearanceBody2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/domains_select_visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/smart_route_select_visible" />

                <Button
                    android:id="@+id/domains_clear_selection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/smart_route_clear_selection" />
            </LinearLayout>

            <Button
                android:id="@+id/domains_remove_checked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smart_route_remove_checked_domains" />

            <Button
                android:id="@+id/save_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/smart_route_save_profile" />

            <Button
                android:id="@+id/toggle_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/smart_route_show_setup" />

            <LinearLayout
                android:id="@+id/setup_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/default_conf_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/smart_route_default_conf_missing"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_default_conf"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_default_conf_summary"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <LinearLayout
                    android:id="@+id/default_conf_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/default_from_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_load_from_file" />

                    <Button
                        android:id="@+id/default_from_clipboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_paste_from_clipboard" />

                    <Button
                        android:id="@+id/default_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_view_edit_content" />

                    <Button
                        android:id="@+id/default_clear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bypass_conf_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/smart_route_bypass_conf_missing"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_bypass_conf"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_bypass_conf_summary"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <LinearLayout
                    android:id="@+id/bypass_conf_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/bypass_from_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_load_from_file" />

                    <Button
                        android:id="@+id/bypass_from_clipboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_paste_from_clipboard" />

                    <Button
                        android:id="@+id/bypass_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_view_edit_content" />

                    <Button
                        android:id="@+id/bypass_clear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_route_clear" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/toggle_domain_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/smart_route_show_domain_tools" />

            <LinearLayout
                android:id="@+id/domain_tools_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/domains_advanced_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_advanced_domain_edit" />

                <Button
                    android:id="@+id/domains_from_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_import_txt" />

                <Button
                    android:id="@+id/domains_export_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_export_txt" />

                <Button
                    android:id="@+id/domains_normalize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_dedupe" />

                <Button
                    android:id="@+id/domains_sort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_sort" />

                <Button
                    android:id="@+id/domains_clear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_clear_all" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_domain_help"
                    android:textAppearance="?attr/textAppearanceCaption" />
            </LinearLayout>

            <Button
                android:id="@+id/toggle_json_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/smart_route_show_json_tools" />

            <LinearLayout
                android:id="@+id/json_tools_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/validate_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_validate" />

                <Button
                    android:id="@+id/preview_json"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_preview_json" />

                <Button
                    android:id="@+id/copy_json"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_route_copy_json" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
