<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smart_route_root"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="@string/smart_route"
            app:titleEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                app:layout_collapseMode="parallax">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/smart_route_profile_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/smart_route_input_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/smart_route_profile_selector"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:drawablePadding="2dp"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:text="@string/smart_route_current_profile"
                                android:textColor="@color/smart_route_input_text"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                app:drawableEndCompat="@drawable/ic_smart_route_expand"
                                app:drawableTint="@color/smart_route_input_text" />

                            <ImageButton
                                android:id="@+id/smart_route_settings_button"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/smart_route_menu_connection"
                                android:src="@drawable/ic_action_settings"
                                app:tint="@color/smart_route_input_hint" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/smart_route_status_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="36dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">

                            <View
                                android:id="@+id/smart_route_status_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_smart_route_status_dot" />

                            <TextView
                                android:id="@+id/smart_route_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/smart_route_not_configured"
                                android:textColor="@color/smart_route_input_text"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/smart_route_action"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="13sp"
                                android:visibility="gone"
                                app:backgroundTint="?attr/colorPrimary"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/smart_route_conf_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_smart_route_info"
                            android:orientation="vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <LinearLayout
                                android:id="@+id/smart_route_default_row"
                                style="@style/SmartRouteInfoRow">

                                <TextView
                                    style="@style/SmartRouteInfoLabel"
                                    android:text="@string/smart_route_label_default" />

                                <TextView
                                    android:id="@+id/smart_route_default_value"
                                    style="@style/SmartRouteInfoValue" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/smart_route_bypass_row"
                                style="@style/SmartRouteInfoRow">

                                <TextView
                                    style="@style/SmartRouteInfoLabel"
                                    android:text="@string/smart_route_label_bypass" />

                                <TextView
                                    android:id="@+id/smart_route_bypass_value"
                                    style="@style/SmartRouteInfoValue" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/smart_route_proxy_row"
                                style="@style/SmartRouteInfoRow">

                                <TextView
                                    style="@style/SmartRouteInfoLabel"
                                    android:text="@string/smart_route_label_proxy" />

                                <TextView
                                    android:id="@+id/smart_route_proxy_status"
                                    style="@style/SmartRouteInfoValue" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_smart_route_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/domain_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/smart_route_domain_input_hint"
                        android:imeOptions="actionDone"
                        android:includeFontPadding="false"
                        android:inputType="textUri|textNoSuggestions"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/smart_route_input_text"
                        android:textColorHint="@color/smart_route_input_hint"
                        android:textCursorDrawable="@null"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/domain_add"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/smart_route_add_domain"
                        android:src="@drawable/ic_smart_route_add"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/domain_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/smart_route_domain_preview_empty"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:alpha="0.85"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:theme="?actionBarTheme"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                app:title="@string/smart_route" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <TextView
        android:id="@+id/domain_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableEndCompat="@drawable/ic_navigation_close"
        app:drawableTint="?attr/colorPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/domain_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="96dp" />

        <include
            android:id="@+id/empty_state"
            layout="@layout/layout_smart_route_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
